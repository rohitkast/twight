# Copy into Vercel → Settings → Environment Variables
# Do NOT commit real values.

SUPABASE_URL=https://rcbnajyufootjbpncwxz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_AI_API_KEY=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_ID=
DRAFTS_PER_PACK=50
HOSTED_GEMINI_MODEL=gemini-3.5-flash
# Use the short id only — no quotes, no models/ prefix, no spaces.
# gemini-2.5-flash is blocked for new API keys; use gemini-2.0-flash or gemini-3.5-flash.

# REQUIRED if your Polar token was created in Sandbox (sandbox.polar.sh).
# Omit or set to "production" for live polar.sh tokens.
POLAR_SERVER=sandbox

# Optional — success redirect base if Origin header is missing (e.g. some proxies)
# PUBLIC_APP_URL=https://twight.vercel.app

# --- Local dev only (put these in .env.local — never on Vercel Production) ---
# .env.local OVERRIDES Vercel cloud env when running `npx vercel dev`, so you can keep
# sandbox Polar keys here while production keys stay in the Vercel dashboard.
#
# POLAR_SERVER=sandbox
# POLAR_ACCESS_TOKEN=polar_oat_...   (from sandbox.polar.sh)
# POLAR_PRODUCT_ID=...               (sandbox product)
# POLAR_WEBHOOK_SECRET=whsec_...     (sandbox webhook)
#
# Skip Polar entirely while testing UI + draft crediting:
# MOCK_CHECKOUT=true
